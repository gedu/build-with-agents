#!/usr/bin/env bash
#
# hooks/pre-commit — deterministic redaction gate for a public repository.
#
# Enforces the redaction rule in AGENTS.md. The reasoning, and the honest account of
# what this does and does not close, are in
# decisions/0009-redaction-is-a-repo-wide-rule.md.
#
# WHAT THIS CATCHES
#   * absolute home-directory paths, POSIX and Windows
#   * a small set of well-known secret prefixes and PEM private-key headers
#
# WHAT IT DELIBERATELY DOES NOT CATCH — read this before treating a pass as clean:
#   * a private project or client name written as a bare word. No pattern can tell a
#     public repository name from a client's, so that stays a judgment call and lives
#     in AGENTS.md as an ask-before-writing rule. This is the class that survived a
#     previous audit; a pass here is not evidence about it.
#   * hostnames. Every URL contains one, so a generic pattern is all false positives.
#
# WHERE THE PATTERNS LIVE
#   `hooks/redaction-patterns.sh`, beside this file, sourced at run time. `hooks/commit-msg`
#   sources the same file, so the two gates cannot forbid different things. If it is missing
#   or defines no patterns this exits 2 — a gate with an empty pattern list reports "clean"
#   about nothing, which is the failure mode theory/loops/verifier-availability.md is about.
#
# WHY THIS FILE CAN NAME WHAT IT FORBIDS
#   Every pattern requires a real path segment or a real token body, so the documented
#   placeholder forms (angle-bracketed) never match, and no pattern matches its own
#   source text. That is a property of the patterns, not an exemption for this file:
#   this file is scanned like any other, in both modes. Keep every example here and in
#   AGENTS.md in placeholder form, or this file will correctly block its own commit.
#
# EXIT CODES
#   0  clean
#   1  a finding — something forbidden is present
#   2  the check could not run. NOT a pass. Never conflate with 0.
#
# SCOPE
#   Added lines in the staged diff only, so an unrelated commit is never blocked by a
#   pre-existing finding. `--all` scans every tracked file instead, for an audit.
#
# SELF-TEST
#   `--self-test` builds a throwaway repository and runs this script against it, asserting
#   one exit code per case: a clean tree containing an empty file and a placeholder path,
#   a real home-path finding, an unreadable tracked file, and a copy of this script with no
#   pattern file beside it. Exit 0 every case passed, 1 a case failed, 2 the test could not
#   run. Run it whenever this file OR hooks/redaction-patterns.sh changes.
#   ADR 0013 — a committed executable carries its own test, so it needs no runner and no
#   framework, both of which the portability rule below forbids anyway.
#
# PORTABILITY
#   POSIX `grep -E`, not `rg`. A committed hook must run on a machine that has not
#   installed anything.
#
# ESCAPE HATCH
#   `git commit --no-verify`. Not reimplemented here — a second bypass path would be
#   one more thing to keep honest.

set -euo pipefail

# Byte semantics, not locale semantics, for every tool below. A repository can contain
# bytes that are not valid in the ambient encoding, and under a UTF-8 locale both BSD tr
# and awk abort on them ("Illegal byte sequence", "multibyte conversion failure"). This
# script reports that as exit 2, so the failure is loud rather than a silent pass — but a
# check that cannot run is still not a check. C locale also makes [A-Za-z] mean exactly
# ASCII, which is what every pattern below intends.
export LC_ALL=C

# Print the header block by scanning for it rather than by line number, so editing the
# header cannot silently start printing executable lines.
show_help() {
  awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"
}

die_cannot_run() {
  printf '\n  REDACTION CHECK COULD NOT RUN: %s\n  This is exit 2, not a pass.\n' "$1" >&2
  exit 2
}

# Resolves the directory this script really lives in, following the symlink chain that
# `setup.sh --hooks` installs (.git/hooks/pre-commit -> ../../hooks/pre-commit). Without
# this, git invokes the hook through .git/hooks and the pattern file beside the real
# script is not there. `readlink -f` is not portable — BSD readlink has no -f — so the
# chain is walked by hand, with a bound so a symlink cycle terminates instead of hanging.
script_dir() {
  _p="$1"
  _hops=0
  while [ -L "$_p" ]; do
    _hops=$((_hops + 1))
    [ "$_hops" -le 32 ] || return 1
    _t="$(readlink "$_p")" || return 1
    case "$_t" in
      /*) _p="$_t" ;;
      *)  _p="$(dirname "$_p")/$_t" ;;
    esac
  done
  (cd "$(dirname "$_p")" && pwd)
}

# The pattern list is shared with hooks/commit-msg so the two gates cannot diverge. Every
# failure to load it is exit 2: an empty pattern list would scan every line against nothing
# and report a clean tree, which is the one outcome this gate must never produce.
load_patterns() {
  HOOK_DIR="$(script_dir "$0")" \
    || die_cannot_run "could not resolve this script's own directory in order to find its pattern list"
  PATTERN_FILE="$HOOK_DIR/redaction-patterns.sh"
  [ -r "$PATTERN_FILE" ] \
    || die_cannot_run "the shared pattern list '$PATTERN_FILE' is missing or unreadable"
  # shellcheck source=hooks/redaction-patterns.sh
  . "$PATTERN_FILE" \
    || die_cannot_run "the shared pattern list '$PATTERN_FILE' could not be sourced"
  command -v redaction_patterns >/dev/null 2>&1 \
    || die_cannot_run "'$PATTERN_FILE' defines no redaction_patterns function"
}

# Builds a throwaway repository and re-invokes this script against it, asserting one exit
# code per case. It is not run from the commit path: putting mktemp, git init and chmod
# into every commit would make the gate slower and more failure-prone in exchange for
# testing something that only changes when someone edits this file (ADR 0013).
self_test() {
  SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  [ -x "$SELF" ] || die_cannot_run "could not locate this script in order to re-invoke it"

  TMP="$(mktemp -d)" || die_cannot_run "could not create a temporary directory"
  # Case 4 needs a copy of this script with NO pattern file beside it, so it cannot live
  # inside TMP — that directory becomes a git repository and the copy would be committed
  # into the fixture it is meant to scan.
  ORPHAN="$(mktemp -d)" || die_cannot_run "could not create a second temporary directory"
  # Restore permissions before removing: case 3 leaves a file at mode 000.
  trap 'chmod -R u+rwX "$TMP" 2>/dev/null || :; rm -rf "$TMP" "$ORPHAN"' EXIT

  ( cd "$TMP" && git init -q . \
      && git config user.email selftest@example.invalid \
      && git config user.name selftest ) >/dev/null 2>&1 \
    || die_cannot_run "could not create the temporary repository"

  FAILED=0

  # expect <wanted-exit-code> <label>
  expect() {
    set +e
    ( cd "$TMP" && "$SELF" --all ) >/dev/null 2>&1
    _got=$?
    set -e
    if [ "$_got" -eq "$1" ]; then
      printf '  ok    %s\n' "$2"
    else
      printf '  FAIL  %s — expected exit %s, got %s\n' "$2" "$1" "$_got" >&2
      FAILED=1
    fi
  }

  _commit() {
    ( cd "$TMP" && git add -A && git commit -qm "$1" ) >/dev/null 2>&1 \
      || die_cannot_run "could not stage the '$1' fixture"
  }

  # Case 1 — clean, including the two shapes that must NOT escalate. An empty tracked file
  # makes grep exit 1, which means "no lines", not "could not read"; and every home-path
  # pattern requires a real path segment, so the documented angle-bracketed placeholders
  # must not match. Both were regressions waiting to happen in the exit-code handling.
  printf 'nothing to see here\n'                    > "$TMP/plain.txt"
  : >                                                 "$TMP/empty.txt"
  printf 'see <home>/.config and <repo>/hooks\n'    > "$TMP/placeholder.txt"
  _commit clean
  expect 0 "clean tree, with an empty file and placeholder paths"

  # Case 2 — a real finding. The forbidden string is assembled at runtime from two
  # fragments that match nothing on their own, because a literal home path written here
  # would make this gate correctly block its own commit. That constraint doubles as a test
  # that the fragments really are inert.
  printf '%s/%s/project\n' '/Users' 'someone'       > "$TMP/leak.txt"
  _commit leak
  expect 1 "an absolute home path is reported"
  rm -f "$TMP/leak.txt"
  _commit unleak

  # Case 3 — the regression this whole test exists for. Before the fix, an unreadable
  # tracked file was skipped in silence and --all printed "clean across N tracked files"
  # and exited 0: a gate reporting a pass on content it never read.
  chmod 000 "$TMP/plain.txt"
  expect 2 "an unreadable tracked file escalates instead of being skipped"
  chmod 644 "$TMP/plain.txt"

  # Case 4 — the pattern list is a separate file now, so it is also a way for this gate to
  # go quiet. A copy of this script with no redaction-patterns.sh beside it must refuse to
  # run rather than scan every line against an empty list and report a clean tree.
  cp "$SELF" "$ORPHAN/pre-commit" && chmod +x "$ORPHAN/pre-commit" \
    || die_cannot_run "could not copy this script in order to test a missing pattern list"
  set +e
  ( cd "$TMP" && "$ORPHAN/pre-commit" --all ) >/dev/null 2>&1
  _got=$?
  set -e
  if [ "$_got" -eq 2 ]; then
    printf '  ok    %s\n' "a missing pattern list escalates instead of scanning nothing"
  else
    printf '  FAIL  %s — expected exit 2, got %s\n' \
      "a missing pattern list escalates instead of scanning nothing" "$_got" >&2
    FAILED=1
  fi

  [ "$FAILED" -eq 0 ] || {
    printf '\n  SELF-TEST FAILED — this gate is not behaving as specified.\n' >&2
    exit 1
  }
  printf '  self-test: all cases passed\n'
  exit 0
}

case "${1:-}" in
  "")           MODE="staged" ;;
  --all)        MODE="all" ;;
  --self-test)  self_test ;;
  --help)       show_help; exit 0 ;;
  *)            die_cannot_run "unknown argument '${1}'. Use no argument, --all, --self-test, or --help." ;;
esac

load_patterns

# Emits `path:line:content` for every added line in the staged diff.
# Filter letters: Added, Copied, Modified, Renamed, and Typechange. `T` matters because
# replacing a tracked symlink with a regular file is an added-content change that ACMR
# alone would skip entirely. Deletions carry no added lines and are excluded.
staged_added_lines() {
  # --text forces a content diff for binary files. Without it git emits only
  # "Binary files a/x and b/y differ", with no added lines at all, so a secret staged
  # inside a blob passes the gate silently. Cost is a larger diff; correctness in a
  # security gate outranks it.
  #
  # tr is not optional and --text is useless without it: awk truncates a record at the
  # first NUL byte, so a blob's added line arrives as an empty string and scans clean.
  # NUL is replaced rather than deleted so two tokens either side of it cannot fuse.
  # The script-wide LC_ALL=C is what keeps tr and awk from aborting on a blob's
  # invalid multibyte bytes; see the note beside it.
  git diff --cached -U0 --no-color --text --diff-filter=ACMRT \
    | tr '\000' ' ' \
    | awk '
    # Header paths need three normalisations, each of which silently misattributed a
    # finding before it was handled: git appends a TAB when the path contains a space,
    # wraps the whole path in QUOTES when it contains non-ASCII or control characters,
    # and writes /dev/null for a side that does not exist. A header that fails to match
    # does not clear `file`, so an unhandled form reports the PREVIOUS file name.
    /^\+\+\+ / {
      p = substr($0, 5)
      sub(/\t.*$/, "", p)
      if (substr(p, 1, 1) == "\"") { p = substr(p, 2, length(p) - 2) }
      if (p == "/dev/null") { file = ""; next }
      sub(/^b\//, "", p)
      file = p
      next
    }
    /^@@ / {
      match($0, /\+[0-9]+/)
      line = substr($0, RSTART + 1, RLENGTH - 1) + 0
      next
    }
    /^\+/ { print file ":" line ":" substr($0, 2); line++ }
  '
}

# Emits `path:line:content` for every line of every tracked file.
all_tracked_lines() {
  # The loop runs in the subshell on the right of the pipe, so a per-file failure cannot
  # be reported through a variable. It is accumulated and returned as the subshell's exit
  # status instead, which `pipefail` then propagates to the caller. Returning early is
  # wrong here: the point of --all is to audit every file, so an unreadable one is
  # recorded and the scan continues.
  git ls-files -z | {
    rc=0
    while IFS= read -r -d '' f; do
      [ -f "$f" ] || continue
      # -a forces binary files to be read as text. Without it grep prints
      # "Binary file X matches" instead of the content, and a secret embedded in a blob
      # is invisible while the run still reports "clean across N tracked files".
      #
      # grep's three states matter here exactly as they do at the pattern loop below:
      # 0 emitted lines, 1 the file is legitimately empty, >1 it could not be read.
      # `|| :` collapsed all three, so an unreadable tracked file was skipped in silence
      # and --all still reported "clean across N tracked files" — a fail-open in a gate.
      # grep's stderr is deliberately no longer discarded: when this escalates to exit 2,
      # its message is the only thing that says which file and why.
      set +e
      grep -a -nH '' -- "$f"
      grc=$?
      set -e
      [ "$grc" -le 1 ] || rc=2
    done
    [ "$rc" -eq 0 ]
  }
}

# A failure to read the candidate is exit 2, never an empty haystack that scans clean.
case "$MODE" in
  staged) HAYSTACK="$(staged_added_lines)" || die_cannot_run "could not read the staged diff" ;;
  all)    HAYSTACK="$(all_tracked_lines)"  || die_cannot_run "could not read every tracked file; see the error above it" ;;
esac

FOUND=0
APPLIED=0
# The here-doc keeps this loop in the current shell, so FOUND survives it. A pipe from
# redaction_patterns would run the body in a subshell and every finding would be lost.
while IFS= read -r entry; do
  case "$entry" in ''|'#'*) continue ;; esac
  label="${entry%%|*}"
  regex="${entry#*|}"
  [ "$label" != "$entry" ] || die_cannot_run "malformed pattern entry, no '|' separator: '$entry'"
  APPLIED=$((APPLIED + 1))
  # grep exits 0 on match, 1 on no match, and >1 on error. Collapsing all three with
  # `|| :` would read a broken pattern as "nothing found" and pass the commit, so the
  # error case is separated and escalated instead.
  set +e
  hits="$(printf '%s\n' "$HAYSTACK" | grep -E -- "$regex")"
  rc=$?
  set -e
  [ "$rc" -le 1 ] || die_cannot_run "grep exited $rc on the '$label' pattern"
  [ -n "$hits" ] || continue
  if [ "$FOUND" -eq 0 ]; then
    printf '\n  REDACTION CHECK FAILED — this repo is public.\n' >&2
    FOUND=1
  fi
  printf '\n  %s:\n' "$label" >&2
  printf '%s\n' "$hits" | sed 's/^/    /' >&2
done <<PATTERN_LIST
$(redaction_patterns)
PATTERN_LIST

# Zero applied patterns means every line was compared against nothing. Reporting that as
# clean is the exact fail-open this gate exists to refuse.
[ "$APPLIED" -gt 0 ] || die_cannot_run "no usable patterns in '$PATTERN_FILE'"

if [ "$FOUND" -eq 1 ]; then
  cat >&2 <<'MSG'

  Fix, per AGENTS.md:
    * inside this project   -> a repo-relative path
    * outside, public       -> the canonical name (owner/repo), never a path
    * outside, private      -> describe its role
    * a secret              -> remove it, then rotate it. It is already on disk.

  Not covered by this check: a private project or client name as a bare word.
  Ask how to refer to a shared source before writing it. See AGENTS.md.
MSG
  exit 1
fi

[ "$MODE" = "all" ] && printf '  redaction check: clean across %s tracked files\n' "$(git ls-files | wc -l | tr -d ' ')"
exit 0
